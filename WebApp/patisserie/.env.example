# ── Base de données ──────────────────────────────────────────
# Mot de passe PostgreSQL (doit correspondre à POSTGRES_PASSWORD ci-dessous)
DATABASE_URL="postgresql://patisserie:MOT_DE_PASSE@localhost:5432/patisserie"
# Variables utilisées par le conteneur PostgreSQL (docker-compose.prod.yml)
POSTGRES_USER="patisserie"
POSTGRES_PASSWORD="MOT_DE_PASSE"
POSTGRES_DB="patisserie"

# ── Port exposé par le conteneur app ─────────────────────────
PORT=3000

# ── Authentification (next-auth v5) ──────────────────────────
# Doit faire au moins 32 caractères. Générer avec : openssl rand -base64 32
AUTH_SECRET="change-me-32-chars-minimum"
NEXTAUTH_URL="http://localhost:3000"

# ── Resend (emails transactionnels) ──────────────────────────
# Clé API Resend. Laisser vide en démo : les emails sont alors
# simplement ignorés (aucune erreur, voir mail.service.ts).
RESEND_API_KEY=""
# Domaine vérifié dans Resend — utilisé pour l'adresse d'expédition
# (commandes@DOMAINE_EMAIL). Obligatoire pour un envoi réel.
DOMAINE_EMAIL="ton-domaine.fr"
# Adresse de réponse affichée au client.
REPLY_TO_EMAIL="contact@ton-domaine.fr"
