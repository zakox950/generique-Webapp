# ── Base de données (Postgres dédié, voir docker-compose.yml) ──────────────
DATABASE_URL="postgresql://spyfie:spyfie_dev@localhost:5430/spyfie"

# ── Accès admin ────────────────────────────────────────────────────────────
# Mot de passe de la console admin (route non listée /admin).
ADMIN_PASSWORD="change-moi"
# Secret de signature du cookie de session (HMAC). >= 32 caractères aléatoires.
SESSION_SECRET="change-moi-32-caracteres-minimum-aleatoires"

# ── Stockage des captures ──────────────────────────────────────────────────
# Dossier local (dev) ou volume monté (prod) où Playwright écrit les screenshots.
# Seul le chemin est stocké en base, jamais l'image.
STORAGE_DIR="./data/shots"

# ── Serveur ────────────────────────────────────────────────────────────────
PORT="3100"
